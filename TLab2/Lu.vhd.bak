LIBRARY IEEE;
use IEEE.std_logic_1164.all;

-- Logic Unit
entity LU is
	port(
		W, Y: in std_logic_vector(3 downto 0);
		OP: in std_logic; -- OPx(0): 0 = OR, 1 = XOR
		R: out std_logic_vector(3 downto 0));
end LU;

architecture ARCH_LU of LU is
begin
R <= (W or Y) and not ((W and Y) and (3 downto 0 => OP));
end ARCH_LU;
